NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/admintool
REDIS_URL=redis://127.0.0.1:6379
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_CLIENT_URL=http://localhost:5173
STUDENT_CLIENT_URL=http://localhost:5174
# Production (Vercel) examples:
# ADMIN_CLIENT_URL=https://campusflow-admin-flame.vercel.app
# STUDENT_CLIENT_URL=https://campusflow-student-smoky.vercel.app
# EXTRA_CORS_ORIGINS=https://some-preview.vercel.app
# ALLOW_VERCEL_APP_ORIGINS=true
# PUBLIC_API_URL=https://api.bits.bhupeshb7.me
STUDENT_PORTAL_INSTITUTE_ID=
EMAIL_NOTIFICATIONS_ENABLED=true
EMAIL_QUEUE_CONCURRENCY=5
OPERATIONS_QUEUE_CONCURRENCY=3
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_HOURS=12
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=EduPortal <noreply@your-institute.edu>
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
SESSION_INACTIVITY_HOURS=24
MAX_KNOWLEDGE_FILE_MB=10
MAX_KNOWLEDGE_FILES_PER_SERVICE=10
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Vision-capable model used to read image / scanned document uploads
OPENAI_VISION_MODEL=gpt-4o
# AI-driven verification of application documents & eligibility (set true to enable)
AI_VERIFICATION_ENABLED=false
AI_VERIFY_AUTO_APPROVE_THRESHOLD=0.85
AI_VERIFY_AUTO_REJECT_THRESHOLD=0.8
AI_VERIFICATION_QUEUE_CONCURRENCY=2
PINECONE_API_KEY=
PINECONE_INDEX=study-project-chatbot
# Personal Gmail (no custom domain): OAuth — run `npm run google:oauth-setup` once
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/oauth2callback
GOOGLE_OAUTH_REFRESH_TOKEN=
# Google Workspace later: service account JSON + impersonated workspace user
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
GOOGLE_CALENDAR_IMPERSONATE_EMAIL=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata
# Razorpay (test keys from dashboard.razorpay.com)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Monitoring & Observability
# Optional bearer token to protect GET /metrics (leave blank for open access)
METRICS_TOKEN=
HEALTH_MONITOR_ENABLED=true
HEALTH_MONITOR_INTERVAL_MS=60000
# ERP export & sync
EXPORT_MAX_ROWS=10000
ERP_SYNC_MAX_PAGE_SIZE=200
