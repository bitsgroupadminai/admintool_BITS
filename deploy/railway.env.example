################################################################################
# SINGLE ENV TEMPLATE FOR RAILWAY BACKEND
# Copy these keys into Railway → Variables (or paste as a bulk env file).
# Replace every YOUR_* / empty secret before going live.
################################################################################

# --- Runtime ---
NODE_ENV=production
# PORT is set automatically by Railway — do not set unless you know you need it

# --- Data (paste your Atlas + Redis Cloud URLs) ---
MONGODB_URI=YOUR_MONGODB_ATLAS_URI
REDIS_URL=YOUR_REDIS_CLOUD_URL

# --- Security ---
SESSION_SECRET=replace-with-a-long-random-string-at-least-16-chars

# --- Frontends (Vercel domains — already chosen) ---
ADMIN_CLIENT_URL=https://eduportal-admin.vercel.app
STUDENT_CLIENT_URL=https://eduportal-student.vercel.app

# Optional: comma-separated extra origins (Vercel preview deployments)
# EXTRA_CORS_ORIGINS=https://eduportal-admin-git-main-xxxx.vercel.app

# Public API URL (set after Railway gives you a domain)
# PUBLIC_API_URL=https://YOUR-RAILWAY-APP.up.railway.app

# --- Optional AI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
AI_VERIFICATION_ENABLED=false
AI_VERIFY_AUTO_APPROVE_THRESHOLD=0.85
AI_VERIFY_AUTO_REJECT_THRESHOLD=0.8
AI_VERIFICATION_QUEUE_CONCURRENCY=2

# --- Optional RAG ---
PINECONE_API_KEY=
PINECONE_INDEX=study-project-chatbot

# --- Optional email ---
EMAIL_NOTIFICATIONS_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EduPortal <noreply@your-institute.edu>

# --- Optional payments ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Optional Google Meet ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/oauth2callback
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata

# --- Ops ---
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_HOURS=12
HEALTH_MONITOR_ENABLED=true
HEALTH_MONITOR_INTERVAL_MS=60000
EXPORT_MAX_ROWS=10000
ERP_SYNC_MAX_PAGE_SIZE=200
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
SESSION_INACTIVITY_HOURS=24
MAX_KNOWLEDGE_FILE_MB=10
MAX_KNOWLEDGE_FILES_PER_SERVICE=10
