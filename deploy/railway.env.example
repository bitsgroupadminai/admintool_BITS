################################################################################
# Railway Variables template (NO secrets — safe to commit)
# Copy structure into Railway → Variables. Use deploy/railway.env locally (gitignored).
################################################################################

NODE_ENV=production

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/admintool?retryWrites=true&w=majority
REDIS_URL=redis://default:PASSWORD@HOST:PORT

SESSION_SECRET=replace-with-a-long-random-string-at-least-16-chars

ADMIN_CLIENT_URL=https://campusflow-admin-flame.vercel.app
STUDENT_CLIENT_URL=https://eduportal-student.vercel.app

# true = allow any https://*.vercel.app (temporary while domains change)
ALLOW_VERCEL_APP_ORIGINS=true

# After Railway gives a public URL:
# PUBLIC_API_URL=https://YOUR-APP.up.railway.app

OPENAI_API_KEY=
AI_VERIFICATION_ENABLED=false
PINECONE_API_KEY=
PINECONE_INDEX=
EMAIL_NOTIFICATIONS_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
# Must use the same mailbox as SMTP_USER (Gmail rejects mismatched From)
SMTP_FROM=CampusFlow <your-gmail@gmail.com>
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CACHE_ENABLED=true
HEALTH_MONITOR_ENABLED=true
