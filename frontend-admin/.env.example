# Local / Vercel Environment Variables for Admin portal
# On Vercel Project Settings → Environment Variables, set Production values.

# Required in production (custom API domain)
VITE_API_BASE_URL=https://api.bits.bhupeshb7.me/api/v1

# Optional; defaults to API origin derived from VITE_API_BASE_URL
VITE_SOCKET_URL=https://api.bits.bhupeshb7.me

# Leave both unset for local `npm run dev` (Vite proxy to localhost:5001)
