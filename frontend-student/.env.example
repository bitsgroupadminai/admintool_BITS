# Local / Vercel Environment Variables for Student portal
# On Vercel Project Settings → Environment Variables, set Production values.

# Required in production (Railway backend URL — replace after backend deploy)
VITE_API_BASE_URL=https://YOUR-RAILWAY-APP.up.railway.app/api/v1

# Optional; defaults to API origin derived from VITE_API_BASE_URL
VITE_SOCKET_URL=https://YOUR-RAILWAY-APP.up.railway.app

# Leave both unset for local `npm run dev` (Vite proxy to localhost:5001)
