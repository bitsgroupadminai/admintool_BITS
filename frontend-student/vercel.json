{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.bits.bhupeshb7.me/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://api.bits.bhupeshb7.me/uploads/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
